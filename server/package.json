{
  "name": "boardsync-server",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --runInBand",
    "test:watch": "jest --watch --forceExit",
    "db:init": "node -e \"const {pool}=require('./src/db');const fs=require('fs');pool.query(fs.readFileSync('./src/db/schema.sql','utf8')).then(()=>{console.log('Schema created');process.exit()})\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "socket.io-client": "^4.7.5",
    "supertest": "^7.0.0"
  }
}
